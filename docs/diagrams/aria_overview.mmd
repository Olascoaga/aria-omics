flowchart TD
    U["User Question + Local Data / GEO"] --> O["OrchestratorAgent + ExperimentSession"]
    O --> DA["DataAuditAgent"]
    DA --> CP1["Checkpoint 1: Detected Modalities & Contracts"]
    CP1 --> RAW["RawIngestionAgent"]
    CP1 --> D["DesignAgent"]
    RAW --> D
    D --> CP2["Checkpoint 2 / 2.5: Design, Replicates & Contrasts"]
    CP2 --> CP3["Checkpoint 3: Plan & Thresholds"]
    CP3 --> A["AuditAgent + modality_audit"]
    A -->|Beta ack required or blocking risks| CP35["Checkpoint 3.5: Proceed or Cancel"]
    A -->|No blocking issues| SETUP["SetupAgent + EnvironmentManager"]
    CP35 -->|Proceed| SETUP
    SETUP --> B["BulkRNAAgent (production)"]
    SETUP --> S["scRNAAgent (production)"]
    SETUP --> C["ChromatinAgent (scATAC & bulk ATAC production)"]
    SETUP --> INT["IntegrationAgent (paired Multiome beta)"]
    SETUP -. disabled by default .-> H["GenomeArchAgent (scaffold)"]
    B --> N["NarrativeAgent + Synthesis + Triangulation"]
    S --> N
    C --> N
    INT --> N
    N --> COMP["C1-C4 Claim Compiler + W-CLAIM + W-LEDGER"]
    COMP --> R["HTML Report + methodology.json + RO-Crate + Capsule"]
    COMP -. "--hypotheses opt-in" .-> HYPO["HypothesisAgent S0-S10 (SPECULATIVE)"]
