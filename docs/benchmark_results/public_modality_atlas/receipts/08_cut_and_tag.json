  "prompt": {
    "user_question": "Compare Polycomb H3K27me3 repressive chromatin domains between human K562 erythroleukemia cells and H1 embryonic stem cells using the founding Kaya-Okur et al. 2019 paired-end CUT&Tag FASTQ replicates calibrated against matched IgG negative controls on GRCh38 (GEO GSE124557). Execute fastp QC, Tn5-aware bwa-mem2 alignment, fragment-size and FRiP QC, IgG-calibrated SEACR peak calling, consensus quantification, pyDESeq2 differential binding (K562 versus H1, disclosing n=2 replicate power), and cis gene/pathway annotation.",
    "reproducible_mode": true,
    "enable_hypotheses": true,
    "comparisons": [
      [
        "K562",
        "H1"
      ]
    ],
    "condition_col": "condition",
    "replicate_col": "replicate"
  },
