# ARIA multi-omic integration image — PRODUCTION / VALIDATED (ADR-079).
# Builds FROM the common base and adds ONLY the hermetic aria-integration-env
# stack pinned in envs/aria-integration-env.yml (muon/mudata WNN, mofapy2
# MOFA+, cis peak-to-gene + candidate eRegulon motif scanning) used by
# aria/scripts/integration_*.py. Promoted to production in ADR-079 for verified
# paired same-cell RNA+ATAC only (`.h5mu`, Cell Ranger ARC `.h5`/MEX, raw
# Multiome FASTQs, multi-donor paired cohorts with batch-aware WNN). Unpaired,
# diagonal, and bulk cross-modal integration remain blocked fail-closed;
# peak-to-gene / eRegulons / MOFA+ factors stay `production_associative`.
#
# Build:
#   docker build -f docker/Dockerfile.base -t aria-base:local \
#     --build-arg ARIA_IMAGE_REVISION=$(git rev-parse HEAD) .
#   docker build -f docker/Dockerfile.integration -t aria-integration:local \
#     --build-arg ARIA_IMAGE_ENV_SHA=$(sha256sum envs/aria-integration-env.yml | cut -d' ' -f1) .
ARG ARIA_BASE_IMAGE=aria-base:local
FROM ${ARIA_BASE_IMAGE}

ARG MAMBA_DOCKERFILE_ACTIVATE=1
RUN micromamba install -y -n base -f /opt/aria/envs/aria-integration-env.yml && \
    micromamba clean --all --yes
RUN python -m pip install --no-deps -e /opt/aria

ARG ARIA_IMAGE_ENV_SHA=unknown
ENV ARIA_IMAGE_KIND=integration \
    ARIA_IMAGE_VALIDATION=validated \
    ARIA_IMAGE_ENV_SHA=${ARIA_IMAGE_ENV_SHA} \
    NUMBA_CACHE_DIR=/tmp/numba_cache

LABEL org.opencontainers.image.title="aria-integration" \
      org.opencontainers.image.description="ARIA paired same-cell multiome integration image (ADR-079)"

WORKDIR /work
ENTRYPOINT ["/usr/local/bin/_entrypoint.sh"]
CMD ["aria"]
