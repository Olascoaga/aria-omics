# ARIA raw ATAC-seq FASTQ preprocessing image (ADR-076).
# Builds FROM the common base and adds ONLY the hermetic aria-atacseq-env stack
# (bwa-mem2 + samtools for bulk ATAC FASTQ -> filtered BAM via
# aria/scripts/atac_align.py; chromap for scATAC FASTQ -> fragments via
# aria/scripts/chromatin_scatac_align.py). Kept separate from the chromatin
# analysis image so the aligner stack never perturbs the analysis lock.
#
# Build:
#   docker build -f docker/Dockerfile.base -t aria-base:local \
#     --build-arg ARIA_IMAGE_REVISION=$(git rev-parse HEAD) .
#   docker build -f docker/Dockerfile.atacseq -t aria-atacseq:local \
#     --build-arg ARIA_IMAGE_ENV_SHA=$(sha256sum envs/aria-atacseq-env.yml | cut -d' ' -f1) .
ARG ARIA_BASE_IMAGE=aria-base:local
FROM ${ARIA_BASE_IMAGE}

ARG MAMBA_DOCKERFILE_ACTIVATE=1
RUN micromamba install -y -n base -f /opt/aria/envs/aria-atacseq-env.yml && \
    micromamba clean --all --yes
RUN python -m pip install --no-deps -e /opt/aria

ARG ARIA_IMAGE_ENV_SHA=unknown
ENV ARIA_IMAGE_KIND=atacseq \
    ARIA_IMAGE_VALIDATION=validated \
    ARIA_IMAGE_ENV_SHA=${ARIA_IMAGE_ENV_SHA}

LABEL org.opencontainers.image.title="aria-atacseq" \
      org.opencontainers.image.description="ARIA raw ATAC-seq FASTQ preprocessing image (bwa-mem2, samtools, chromap)"

WORKDIR /work
ENTRYPOINT ["/usr/local/bin/_entrypoint.sh"]
CMD ["aria"]
